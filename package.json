{
  "name": "@tappify/extension-sdk",
  "version": "2.0.0",
  "description": "Build extensions that run inside Tappify",
  "author": "Tappify Team",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.mjs",
      "require": "./dist/manifest.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.mjs",
      "require": "./dist/host.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.cjs"
    },
    "./testing/vitest": {
      "types": "./dist/testing/vitest.d.ts",
      "import": "./dist/testing/vitest.mjs",
      "require": "./dist/testing/vitest.cjs"
    },
    "./testing/jest": {
      "types": "./dist/testing/jest.d.ts",
      "import": "./dist/testing/jest.mjs",
      "require": "./dist/testing/jest.cjs"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "import": "./dist/codegen.mjs",
      "require": "./dist/codegen.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./schema/extension-v2.json": "./schema/extension-v2.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css",
    "./dist/testing/vitest.*",
    "./dist/testing/jest.*"
  ],
  "files": [
    "dist",
    "schema"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tappify-dev/extension-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/tappify-dev/extension-sdk/issues"
  },
  "homepage": "https://docs.tappify.ai/extensions",
  "keywords": [
    "tappify",
    "extension",
    "extension-sdk",
    "react",
    "module-federation"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && node scripts/copy-styles.mjs",
    "build:schema": "tsx scripts/build-json-schema.ts",
    "build:manifest-reference": "tsx scripts/build-manifest-reference.ts",
    "build:api-reference": "tsx scripts/build-api-reference.ts",
    "docs:examples": "tsx scripts/check-tsdoc-examples.ts && tsc -p tsconfig.examples.json",
    "docs:validate": "typedoc --options typedoc.frontend.json --emit none && typedoc --options typedoc.server.json --emit none && typedoc --options typedoc.testing.json --emit none",
    "docs:reference": "pnpm docs:examples && pnpm docs:validate && pnpm build:schema && pnpm build:manifest-reference && pnpm build:api-reference",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"*.{json,md,mjs,cjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"*.{json,md,mjs,cjs}\"",
    "lint": "eslint \"{src,test}/**/*.{ts,tsx}\" --fix",
    "test": "vitest run --passWithNoTests --coverage",
    "test:watch": "vitest --watch",
    "prepare": "husky",
    "commit": "cz",
    "prepublishOnly": "npm run build && npm test",
    "spellcheck": "cspell \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"*.{json,md,yml,mjs,cjs}\" \".github/**/*.yml\"",
    "semantic-release": "semantic-release"
  },
  "peerDependencies": {
    "@module-federation/vite": ">=1.16.0",
    "@tanstack/react-query": "^5.100.0",
    "@testing-library/react": ">=16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": ">=8.0.0",
    "vitest": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@module-federation/vite": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "json-schema-to-typescript": "^16.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/js": "^10.0.1",
    "@module-federation/vite": "~1.16.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tanstack/react-query": "^5.100.14",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^3.0.0",
    "commitizen": "^4.3.1",
    "conventional-changelog-conventionalcommits": "^9.3.0",
    "cspell": "^9.7.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.4.0",
    "happy-dom": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "semantic-release": "^25.0.3",
    "tsup": "^8.3.0",
    "tsx": "^4.20.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.14",
    "vitest": "^3.0.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog",
      "types": {
        "feat": {
          "description": "New feature",
          "title": "Features"
        },
        "fix": {
          "description": "Bug fix",
          "title": "Fixes"
        },
        "docs": {
          "description": "Documentation changes",
          "title": "Documentation"
        },
        "style": {
          "description": "Code style changes (formatting, etc.)",
          "title": "Styles"
        },
        "refactor": {
          "description": "Code refactoring",
          "title": "Refactoring"
        },
        "perf": {
          "description": "Performance improvements",
          "title": "Performance"
        },
        "test": {
          "description": "Adding or updating tests",
          "title": "Tests"
        },
        "build": {
          "description": "Build system or dependencies",
          "title": "Build"
        },
        "ci": {
          "description": "CI/CD changes",
          "title": "CI/CD"
        },
        "chore": {
          "description": "Chore",
          "title": "Chores"
        },
        "revert": {
          "description": "Revert previous commit",
          "title": "Reverts"
        },
        "wip": {
          "description": "Work in progress / continuing a feature",
          "title": "Work in Progress"
        },
        "cont": {
          "description": "Continue/complete a feature",
          "title": "Continue Feature"
        },
        "improve": {
          "description": "Small improvements or enhancements",
          "title": "Improvements"
        }
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "cspell --no-must-find-files"
    ],
    "*.{json,md}": [
      "prettier --write",
      "cspell --no-must-find-files"
    ]
  }
}
