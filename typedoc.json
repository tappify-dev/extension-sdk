{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": ["typedoc-plugin-markdown"],
  "tsconfig": "./tsconfig.json",
  "readme": "none",
  "githubPages": false,
  "excludeInternal": true,
  "excludePrivate": true,
  "disableSources": true,
  "skipErrorChecking": true,
  "outputFileStrategy": "members",
  "flattenOutputFiles": true,
  "fileExtension": ".mdx",
  "entryFileName": "index",
  "hidePageHeader": true,
  "hidePageTitle": true,
  "hideBreadcrumbs": true,
  "useCodeBlocks": true,
  "expandObjects": true,
  "validation": {
    "notExported": false,
    "invalidLink": false,
    "notDocumented": true
  },
  "requiredToBeDocumented": [
    "Function",
    "Class",
    "Interface",
    "TypeAlias",
    "Variable",
    "Enum"
  ],
  "treatValidationWarningsAsErrors": true
}
