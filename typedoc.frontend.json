{
  "$schema": "https://typedoc.org/schema.json",
  "extends": ["./typedoc.json"],
  "entryPoints": ["src/index.ts", "src/ui.ts"],
  "validation": {
    "notExported": true,
    "invalidLink": false,
    "notDocumented": true
  },
  "intentionallyNotExported": [
    "EVENTS",
    "JsonSchema",
    "PageDefinition",
    "SLOTS",
    "ScopeDefinition",
    "TapProcedureEntries"
  ]
}
